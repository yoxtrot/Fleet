# Gitignored local secrets for applying migrations (`npm run db:push`).
# Never put these in VITE_* vars or commit this file.

# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Database password from project creation (Settings → Database)
SUPABASE_DB_PASSWORD=

# Project ref from the dashboard URL / Project Settings
# Optional if VITE_SUPABASE_URL is set in .env.local
SUPABASE_PROJECT_ID=
