# From Supabase Connect dialog / Project Settings → API Keys
# Use the anon (legacy) key or the publishable key — never a secret/service_role key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# UUID of the garage account shown in read-only demo (Supabase Auth → Users)
VITE_DEMO_USER_ID=
